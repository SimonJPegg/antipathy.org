---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  pageTitle: string;
  description?: string;
  ogImage?: string;
  ogDescription?: string;
}

const {
  pageTitle,
  description = "Photography by Ciaran",
  ogImage = "/logo.jpg",
  ogDescription = "Photography by Ciaran",
} = Astro.props;
const ogTitle = `antipathy.org : ${pageTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      href="https://fonts.googleapis.com/css?family=Poiret+One:400,300,700"
      rel="stylesheet"
    />
    <title>antipathy.org : {pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="site">
      <Navigation />
      <div class="site-content">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    font-family: "Poiret One", fantasy;
    height: 100%;
    margin: 0;
    color: #777;
    background-color: #080808;
  }

  a {
    text-decoration: underline;
    color: #777;
  }

  a:visited {
    text-decoration: underline;
    color: #555;
  }
</style>

<style>
  .site {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .site-content {
    flex-grow: 1;
  }
</style>
