---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css?family=Poiret+One:400,300,700"
      rel="stylesheet"
    />
    <title>antipathy.org : {pageTitle}</title>
  </head>
  <body>
    <div class="site">
      <Navigation />
      <div class="site-content">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    font-family: "Poiret One", fantasy;
    height: 100%;
    margin: 0;
    color: #777;
    background-color: #080808;
  }

  a {
    text-decoration: underline;
    color: #777;
  }

  a:visited {
    text-decoration: underline;
    color: #555;
  }
</style>

<style>
  .site {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .site-content {
    flex-grow: 1;
  }
</style>
