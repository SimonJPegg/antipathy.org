---
import Layout from "../layouts/Layout.astro";
---

<Layout pageTitle="Not Found">
  <div class="content">
    <h1>Page not found</h1>
    <p>
      Sorry, we couldn't find what you were looking for.
      <br />
      <a href="/">Go home</a>.
    </p>
  </div>
</Layout>

<style>
  .content {
    padding: 96px;
  }

  h1 {
    margin-top: 0;
    margin-bottom: 64px;
    max-width: 320px;
  }

  p {
    margin-bottom: 48px;
  }
</style>
