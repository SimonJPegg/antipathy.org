---
import Layout from "../layouts/Layout.astro";
---

<Layout pageTitle="About">
  <div class="content">
    <div class="hero">
      <h1>About</h1>
    </div>
    <div class="body">
      <p>
        I'm a 40 (something) year old geek from Belfast.
        I take terrible pictures and write terrible code.
      </p>
      <p>Find me elsewhere:</p>
      <div class="links">
        <a href="https://twitter.com/#!/_fluffybacon_">Twitter</a>
        <a href="https://github.com/SimonJPegg">Github</a>
        <a
          href="mailto:&#099;&#105;&#097;&#114;&#097;&#110;&#064;&#097;&#110;&#116;&#105;&#112;&#097;&#116;&#104;&#121;&#046;&#111;&#114;&#103;"
        >Email</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: calc(100vh - 50px);
    background: radial-gradient(ellipse at center, #1a1a1a 0%, #080808 70%);
  }

  .hero {
    width: 100%;
    padding: 80px 0 40px;
    text-align: center;
  }

  .hero h1 {
    font-size: 48px;
    letter-spacing: 8px;
    color: #fff;
    font-weight: 300;
  }

  .body {
    max-width: 600px;
    padding: 0 24px;
    text-align: center;
    line-height: 1.8;
  }

  .body p {
    font-size: 18px;
  }

  .links {
    display: flex;
    gap: 32px;
    justify-content: center;
    margin-top: 24px;
  }

  .links a {
    color: #aaa;
    text-decoration: none;
    letter-spacing: 2px;
    font-size: 16px;
    transition: color 0.2s;
  }

  .links a:hover {
    color: #fff;
  }
</style>
