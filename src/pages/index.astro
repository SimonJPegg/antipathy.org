<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      href="https://fonts.googleapis.com/css?family=Poiret+One:400,300,700"
      rel="stylesheet"
    />
    <title>Antipathy.org - Photography</title>
    <meta name="description" content="Photography by Ciaran" />
    <meta property="og:title" content="Antipathy.org - Photography" />
    <meta property="og:description" content="Photography by Ciaran" />
    <meta property="og:image" content="https://www.antipathy.org/logo.jpg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="titleimage">
      <div class="caption">
        <span class="border">
          Antipathy.org
          <br />Photography
          <br /><a href="/photos">ENTER SITE</a>
        </span>
      </div>
    </main>
  </body>
</html>

<style>
  html,
  body {
    font-family: "Poiret One", fantasy;
    height: 100%;
    margin: 0;
    color: #777;
    background-color: #080808;
  }

  .titleimage {
    background-image: url("/logo.jpg");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    height: 100vh;
    width: 100vw;
    opacity: 0.75;
  }

  .caption {
    font-weight: bold;
    font-size: x-large;
    position: absolute;
    left: 0;
    top: 30%;
    width: 100%;
    text-align: center;
    color: #000;
    text-shadow:
      1px 0 0 #000,
      0 -1px 0 #000,
      0 1px 0 #000,
      -1px 0 0 #000;
  }

  .caption a {
    font-size: small;
    letter-spacing: 5px;
    text-decoration: none;
    color: #fff;
    padding: 8px 16px;
  }

  .caption a:hover {
    color: #ccc;
  }

  .caption span.border {
    color: #fff;
    padding: 18px;
    font-size: 25px;
    letter-spacing: 10px;
    opacity: 0.65;
  }
</style>
