---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPhotos = (await getCollection("photos")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

export async function getStaticPaths() {
  const photos = (await getCollection("photos")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );
  return photos.map((photo, i) => ({
    params: { slug: photo.data.slug },
    props: {
      photo,
      prev: photos[i - 1] ?? null,
      next: photos[i + 1] ?? null,
    },
  }));
}

const { photo, prev, next } = Astro.props;
---

<Layout pageTitle={photo.data.title} ogImage={photo.data.photo.src} ogDescription={photo.data.title}>
  <div class="photo-page">
    <h2 class="title">{photo.data.title}</h2>
    <div class="image-container">
      <Image
        src={photo.data.photo}
        alt={photo.data.description ?? photo.data.title}
        widths={[800, 1400, 2000]}
        sizes="80vw"
        format="webp"
        quality={90}
        class="photo"
      />
    </div>
    <nav class="photo-nav" aria-label="Photo navigation">
      {prev ? (
        <a href={`/photos/${prev.data.slug}/`} class="nav-link prev">
          &larr; {prev.data.title}
        </a>
      ) : <span />}
      <a href="/photos/" class="nav-link grid">Grid</a>
      {next ? (
        <a href={`/photos/${next.data.slug}/`} class="nav-link next">
          {next.data.title} &rarr;
        </a>
      ) : <span />}
    </nav>
  </div>
</Layout>

<style>
  .title {
    text-align: center;
  }

  .image-container {
    display: flex;
    justify-content: center;
  }

  .photo {
    display: block;
    max-width: 80%;
    height: auto;
    margin: 0 auto;
  }

  .photo-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 32px 48px;
    max-width: 900px;
    margin: 0 auto;
  }

  .nav-link {
    color: #aaa;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 1px;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link.prev {
    text-align: left;
  }

  .nav-link.next {
    text-align: right;
  }

  .nav-link.grid {
    color: #555;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .nav-link.grid:hover {
    color: #fff;
  }
</style>
