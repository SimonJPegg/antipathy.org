---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const photos = (await getCollection("photos")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Layout pageTitle="Photos">
  <!-- Grid overlay panel — fixed, toggleable, follows the user -->
  <div class="grid-panel open" id="grid-panel">
    <div class="grid-panel-header">
      <span class="grid-panel-title">Gallery</span>
      <button class="grid-panel-close" id="grid-close" aria-label="Close grid">&times;</button>
    </div>
    <div class="grid-panel-body">
      {
        photos.map((photo, i) => (
          <button
            class="grid-item"
            data-index={i}
            aria-label={`View ${photo.data.title}`}
          >
            <Image
              src={photo.data.photo}
              alt={photo.data.description ?? photo.data.title}
              width={220}
              height={138}
              format="webp"
              quality={70}
              loading="lazy"
            />
            <span class="grid-title">{photo.data.title}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Grid toggle button — visible when panel is closed -->
  <button class="grid-btn hidden" id="grid-open" aria-label="Open grid">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <rect x="3" y="3" width="7" height="7" rx="1"/>
      <rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="3" y="14" width="7" height="7" rx="1"/>
      <rect x="14" y="14" width="7" height="7" rx="1"/>
    </svg>
  </button>

  <!-- Parallax view — always present -->
  <div class="parallax-container" id="parallax-view">
    {
      photos.map((photo, i) => (
        <section
          class="photo-section"
          id={`photo-${i}`}
          style={`background-image: url('${photo.data.photo.src}');`}
        >
          {i > 0 && (
            <div class="scroll-hint up">
              <span class="chevron">&#8963;</span>
            </div>
          )}
          <div class="photo-frame">
            <Image
              src={photo.data.photo}
              alt={photo.data.description ?? photo.data.title}
              widths={[600, 1200, 1800]}
              sizes="80vw"
              format="webp"
              quality={85}
              class="photo-original"
              loading="lazy"
            />
          </div>
          <div class="photo-title">
            <span>{photo.data.title}</span>
            <span class="counter">{i + 1} / {photos.length}</span>
          </div>
          {i < photos.length - 1 && (
            <div class="scroll-hint down">
              <span class="chevron">&#8964;</span>
            </div>
          )}
        </section>
      ))
    }
  </div>
</Layout>

<script>
  const gridPanel = document.getElementById("grid-panel")!;
  const gridOpen = document.getElementById("grid-open")!;
  const gridClose = document.getElementById("grid-close")!;
  const gridItems = document.querySelectorAll<HTMLButtonElement>(".grid-item");
  const parallaxView = document.getElementById("parallax-view")!;

  function openGrid(): void {
    gridPanel.classList.add("open");
    gridOpen.classList.add("hidden");
  }

  function closeGrid(): void {
    gridPanel.classList.remove("open");
    gridOpen.classList.remove("hidden");
  }

  function scrollToPhoto(index: number): void {
    const target = document.getElementById(`photo-${index}`);
    if (target) {
      target.scrollIntoView({ behavior: "smooth" });
    }
  }

  gridOpen.addEventListener("click", openGrid);
  gridClose.addEventListener("click", closeGrid);

  gridItems.forEach((item) => {
    item.addEventListener("click", () => {
      const index = parseInt(item.dataset.index ?? "0", 10);
      scrollToPhoto(index);
    });
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && gridPanel.classList.contains("open")) {
      closeGrid();
    }
  });

  // Highlight the current photo in the grid as user scrolls
  const sections = document.querySelectorAll<HTMLElement>(".photo-section");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          const index = id.replace("photo-", "");
          gridItems.forEach((item) => item.classList.remove("active"));
          const active = document.querySelector(`.grid-item[data-index="${index}"]`);
          if (active) {
            active.classList.add("active");
            active.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
        }
      });
    },
    { threshold: 0.5 }
  );

  sections.forEach((section) => observer.observe(section));
</script>

<style>
  /* Grid panel — fixed overlay on the left */
  .grid-panel {
    position: fixed;
    top: 50px;
    left: 0;
    bottom: 0;
    width: 220px;
    background: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(8px);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 90;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .grid-panel.open {
    transform: translateX(0);
  }

  .grid-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .grid-panel-title {
    color: #fff;
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .grid-panel-close {
    background: none;
    border: none;
    color: #777;
    font-size: 24px;
    cursor: pointer;
    padding: 0 4px;
    line-height: 1;
  }

  .grid-panel-close:hover {
    color: #fff;
  }

  .grid-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .grid-item {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background: #111;
    border-radius: 4px;
    transition: border-color 0.2s, opacity 0.2s;
    flex-shrink: 0;
  }

  .grid-item:hover {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .grid-item.active {
    border-color: #fff;
  }

  .grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .grid-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 4px 6px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
    color: #fff;
    font-size: 11px;
    letter-spacing: 1px;
    text-align: center;
  }

  /* Grid toggle button */
  .grid-btn {
    position: fixed;
    top: 62px;
    left: 16px;
    z-index: 100;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, opacity 0.3s;
    backdrop-filter: blur(4px);
  }

  .grid-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .grid-btn.hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Parallax view */
  .parallax-container {
    height: calc(100vh - 50px);
    overflow-y: auto;
    overflow-x: hidden;
    perspective: 1px;
  }

  .photo-section {
    position: relative;
    height: calc(100vh - 50px);
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .photo-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .photo-frame {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    padding: 60px 24px 0;
  }

  .photo-original {
    max-height: calc(100vh - 200px);
    max-width: 80%;
    width: auto;
    height: auto;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
  }

  .photo-title {
    position: relative;
    z-index: 1;
    padding: 16px 32px;
    margin-bottom: 60px;
  }

  .photo-title span {
    font-size: 24px;
    color: #fff;
    letter-spacing: 4px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
  }

  .photo-title .counter {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 2px;
    margin-top: 4px;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .scroll-hint.up {
    top: 20px;
    animation: bounce-up 2s infinite;
  }

  .scroll-hint.down {
    bottom: 40px;
    animation: bounce-down 2s infinite;
  }

  .chevron {
    font-size: 48px;
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  @keyframes bounce-down {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(10px);
    }
    60% {
      transform: translateY(5px);
    }
  }

  @keyframes bounce-up {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  /* Mobile: panel becomes bottom sheet */
  @media (max-width: 768px) {
    .grid-panel {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: 180px;
      border-right: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      transform: translateY(100%);
    }

    .grid-panel.open {
      transform: translateY(0);
    }

    .grid-panel-body {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .grid-item {
      min-width: 120px;
      aspect-ratio: 16 / 10;
    }

    .grid-btn {
      top: auto;
      bottom: 16px;
      left: 16px;
    }
  }
</style>
