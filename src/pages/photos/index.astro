---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const photos = await getCollection("photos");

function photoPath(filePath: string | undefined): string {
  const match = filePath?.match(/src\/mdx\/([^/]+)\//);
  return match ? match[1] : "";
}
---

<Layout pageTitle="Photos">
  <div class="parallax-container">
    {
      photos.map((photo, i) => (
        <section
          class="photo-section"
          style={`background-image: url('/mdx/${photoPath(photo.filePath)}/photo.jpg');`}
        >
          {i > 0 && (
            <div class="scroll-hint up">
              <span class="chevron">&#8963;</span>
            </div>
          )}
          <div class="photo-frame">
            <img
              src={`/mdx/${photoPath(photo.filePath)}/photo.jpg`}
              alt={photo.data.title}
              class="photo-original"
              loading="lazy"
            />
          </div>
          <div class="photo-title">
            <span>{photo.data.title}</span>
            <span class="counter">{i + 1} / {photos.length}</span>
          </div>
          {i < photos.length - 1 && (
            <div class="scroll-hint down">
              <span class="chevron">&#8964;</span>
            </div>
          )}
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .parallax-container {
    height: calc(100vh - 50px);
    overflow-y: auto;
    overflow-x: hidden;
    perspective: 1px;
  }

  .photo-section {
    position: relative;
    height: calc(100vh - 50px);
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .photo-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .photo-frame {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    padding: 60px 24px 0;
  }

  .photo-original {
    max-height: calc(100vh - 200px);
    max-width: 80%;
    object-fit: contain;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
  }

  .photo-title {
    position: relative;
    z-index: 1;
    padding: 16px 32px;
    margin-bottom: 60px;
  }

  .photo-title span {
    font-size: 24px;
    color: #fff;
    letter-spacing: 4px;
    text-shadow:
      1px 1px 4px rgba(0, 0, 0, 0.8);
  }

  .photo-title .counter {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 2px;
    margin-top: 4px;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .scroll-hint.up {
    top: 20px;
    animation: bounce-up 2s infinite;
  }

  .scroll-hint.down {
    bottom: 40px;
    animation: bounce-down 2s infinite;
  }

  .chevron {
    font-size: 48px;
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  @keyframes bounce-down {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(10px);
    }
    60% {
      transform: translateY(5px);
    }
  }

  @keyframes bounce-up {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }
</style>
